# PostgreSQL application connection. Use a restricted runtime role in deployed environments.
DATABASE_URL="postgresql://balancevault_app:local-app-change-me@localhost:5432/balancevault?schema=public"
# Migration owner connection; use only for migrations, never in the running API.
DIRECT_URL="postgresql://balancevault_migrator:local-migrator-change-me@localhost:5432/balancevault?schema=public"

# Required secrets: generate independent random values of at least 32 bytes.
ACCESS_TOKEN_SECRET="789456123789456123789456123"
BOOTSTRAP_ADMIN_EMAIL="admin@example.test"
BOOTSTRAP_ADMIN_PASSWORD="rukus"
BOOTSTRAP_ADMIN_TOKEN="admin_rukus"

# App runtime
NODE_ENV="development"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
API_BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:5173"
ACCESS_TOKEN_TTL="10m"
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Redis is used for rate limiting when reachable. In-memory fallback is used if unavailable.
REDIS_URL="redis://localhost:6379"

# Demo seed values; synthetic data only.
DEMO_USER_EMAIL="demo@example.test"
DEMO_USER_PASSWORD="demo-user-password-please-change"
DEMO_RECIPIENT_EMAIL="recipient@example.test"
DEMO_RECIPIENT_PASSWORD="demo-recipient-password-change-me"
DEMO_ADMIN_EMAIL="admin@example.test"
DEMO_ADMIN_PASSWORD="replace-with-a-long-demo-password"

# Optional: verification script can authenticate as an existing demo admin.
VERIFY_DEMO_ADMIN_EMAIL="admin@example.test"
VERIFY_DEMO_ADMIN_PASSWORD="replace-with-a-long-demo-password"
